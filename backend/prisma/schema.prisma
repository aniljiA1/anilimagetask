generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id         Int      @id @default(autoincrement())
  image_url  String
  output_url String
  created_at DateTime @default(now())
}